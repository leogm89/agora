// ============================================================
//  Ágora · Reglas de Firestore
// ============================================================
//  Acceso protegido: solo usuarios autenticados, y cada uno
//  únicamente sobre SUS propios movimientos (campo uid).
//
//  ▶ Para aplicarlas: Firebase Console → Firestore Database →
//    pestaña "Reglas" → pegar esto → Publicar.
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /movimientos/{id} {
      // Leer: logueado y dueño del documento
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      // Crear: logueado y el documento se guarda con SU uid
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Modificar/borrar: logueado y dueño del documento
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Todo lo demás, denegado por defecto.
  }
}
